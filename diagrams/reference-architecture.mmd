    direction LR
    FEAT["Feature service<br/>JIT · near-real-time · batch"]
    ENG["Control engine<br/>sandboxed pure functions"]
    MODEL["Model serving"]
    POL["Policy layer<br/>hard cuts · affordability"]
  end
  subgraph L5["⑤ Core — system of record"]
    LEDGER[["Ledger<br/>double-entry · append-only<br/>idempotent · bi-temporal"]]
    PRODENG["Product engine<br/>interest · fees"]
  end
  subgraph L6["⑥ Money movement — rail adapters"]
