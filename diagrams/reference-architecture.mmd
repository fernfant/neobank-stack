%% Neobank reference architecture — generated from wiki/ on 2026-08-18
%% Legend: [[double]] = system of record / regulated · [/vendor/] = third party
%%         ==> money movement · -.-> async event · ~~~ reconciliation/evidence
flowchart TB
  subgraph L1["① Channels"]
    direction LR
    IOS["iOS"]; AND["Android"]; WEB["Web"]; OPSC["Ops console + AI agent"]
  end
  subgraph L2["② Edge"]
    direction LR
    GW["API gateway / BFF"]; AUTH["AuthN/Z · device binding"]
  end
  subgraph L3["③ Product services"]
    direction LR
    ACCT["Accounts & pots"]; PAY["Payment orchestration"]; CARDM["Card management"]; LEND["Lending & limits"]
  end
